# ------------------------------
# Ghost core runtime
# ------------------------------
# Public canonical URL for your Ghost site.
# Local: http://localhost:2368
# Railway: https://<your-domain>
url=http://localhost:2368

# Node environment
# Local: development
# Railway: production
NODE_ENV=development

# Port Ghost binds to inside container
# Local and Railway typically use 2368
PORT=2368

# ------------------------------
# Database (MySQL only)
# ------------------------------
# Must be mysql for production
# Railway: mysql
# Local compose: mysql
database__client=mysql

# MySQL host
# Local compose: mysql
# Railway: set from MySQL service variable mapping (example: ${MYSQLHOST})
database__connection__host=mysql

# MySQL port
# Local compose: 3306
# Railway: ${MYSQLPORT}
database__connection__port=3306

# MySQL user
# Local compose default: ghost
# Railway: ${MYSQLUSER}
database__connection__user=ghost

# MySQL password
# Local compose default (change for your machine): ghostpass
# Railway: ${MYSQLPASSWORD}
database__connection__password=ghostpass

# MySQL database name
# Local compose default: ghost
# Railway: ${MYSQLDATABASE}
database__connection__database=ghost

# ------------------------------
# Mail (SMTP)
# ------------------------------
# Required for member login links and newsletters
mail__transport=SMTP

# From address shown to members
mail__from=noreply@example.com

# SMTP host (Mailgun/Postmark/SES/etc.)
mail__options__host=smtp.example.com

# SMTP port
# Common STARTTLS port is 587
mail__options__port=587

# For 587 + STARTTLS, set false. For implicit TLS 465, set true.
mail__options__secure=false
# SMTP auth username
mail__options__auth__user=replace-with-smtp-username

# SMTP auth password/token
mail__options__auth__pass=replace-with-smtp-password

# ------------------------------
# Local MySQL container bootstrap
# (used by docker-compose mysql service)
# ------------------------------
MYSQL_ROOT_PASSWORD=local-root-password-change-me
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=ghostpass
